{
  "name": "hattrick-helper",
  "version": "0.1.0",
  "private": true,
  "description": "帽子戏法小助手 (Hattrick Helper) - 零后台抓包、零自动代操的 Hattrick 新手浏览器插件",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "node scripts/build-ext.mjs --target=all",
    "build:chrome": "node scripts/build-ext.mjs --target=chrome",
    "build:firefox": "node scripts/build-ext.mjs --target=firefox"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "preact": "^10.29.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/chrome": "^0.1.32",
    "happy-dom": "^20.0.10",
    "typescript": "^5.8.2",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
